# FashionAI — Environment Configuration
# Copy this file and rename it to .env

# ── SERVER ────────────────────────────
PORT=5000
NODE_ENV=development

# ── AI FEATURES ───────────────────────
# Claude AI is called directly from the browser (no key needed in .env)
# To use Claude from backend, add your key:
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxx

# ── HADOOP (Optional) ─────────────────
HADOOP_ENABLED=false
HADOOP_HOME=/usr/local/hadoop
HDFS_NAMENODE=hdfs://localhost:9000
SPARK_MASTER=spark://localhost:7077
KAFKA_BROKERS=localhost:9092

# ── DATABASE (Optional) ───────────────
DB_HOST=localhost
DB_PORT=27017
DB_NAME=virtual_tryon_db

# ── AI FEATURES FLAGS ─────────────────
ENABLE_VIRTUAL_TRYON=true
ENABLE_BODY_ANALYSIS=true
ENABLE_COLOR_MATCHING=true
ENABLE_RECOMMENDATIONS=true
